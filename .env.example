# Copiar como .env sólo si se desean cambiar los valores predeterminados.
# Mantener privadas las claves propias de HCOP y PostgreSQL.
# Los repositorios de estudios se cargan desde config/study-repositories.env.
# Para usar otras cuentas, indicar una ruta absoluta a un archivo propio:
# HCOP_STUDY_REPOSITORIES_ENV_FILE=C:/HCOP/config/repositorios-privados.env
HCOP_PORT=5180
HCOP_IMAGE=ghcr.io/marcolyto/hcop_jp:latest
HCOP_POSTGRES_IMAGE=postgres:18.4-alpine
HCOP_DB_NAME=hcop_jp
HCOP_DB_USER=hcop
HCOP_DB_PASSWORD=
HCOP_BOOTSTRAP_USERNAME=marcolyto
HCOP_BOOTSTRAP_PASSWORD=
HCOP_BOOTSTRAP_SECOND_USERNAME=marcolyto2
HCOP_SEED_EXAMPLE_PATIENT=true
HCOP_QR_SECRET=
HCOP_ENCRYPTION_SECRET=
HCOP_PUBLIC_BASE_URL=http://localhost:5180
