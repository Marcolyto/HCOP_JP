# Copiar como .env sólo si se desean cambiar los valores predeterminados.
# Nunca versionar contraseñas reales ni claves de servicios externos.
HCOP_PORT=5180
# HCOP_IMAGE es un alias legacy de HCOP_BACKEND_IMAGE (instalaciones previas al corte
# backend/bff/frontend). Si tenés HCOP_IMAGE definido, no hace falta agregar los nuevos.
HCOP_IMAGE=ghcr.io/marcolyto/hcop_jp-backend:latest
HCOP_BACKEND_IMAGE=ghcr.io/marcolyto/hcop_jp-backend:latest
HCOP_FRONTEND_IMAGE=ghcr.io/marcolyto/hcop_jp-frontend:latest
HCOP_POSTGRES_IMAGE=postgres:18.4-alpine
HCOP_REDIS_IMAGE=redis:7-alpine
HCOP_DB_NAME=hcop_jp
HCOP_DB_USER=hcop
HCOP_DB_PASSWORD=
HCOP_BOOTSTRAP_USERNAME=marcolyto
HCOP_BOOTSTRAP_PASSWORD=
HCOP_BOOTSTRAP_SECOND_USERNAME=marcolyto2
HCOP_SEED_EXAMPLE_PATIENT=true
HCOP_QR_SECRET=
HCOP_ENCRYPTION_SECRET=
HCOP_PUBLIC_BASE_URL=http://localhost:5180
