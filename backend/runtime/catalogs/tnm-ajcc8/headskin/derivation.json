{
  "$schema_version": 1,
  "organ": "headskin",
  "edition": "AJCC 8",
  "source": "pdfsource/_pages_headskinv8/p1-p4 (AJCC 8 cutaneous squamous cell carcinoma of the head and neck)",
  "observables": {
    "tumor_size_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the primary tumor in centimeters. No default: absence falls through to TX.",
      "display": {"label": "Greatest tumor dimension (cm)"}
    },
    "histology": {
      "type": "enum",
      "default": "invasive",
      "values": ["in_situ", "invasive", "unknown"],
      "description": "Histologic class. 'in_situ' directs to Tis regardless of size.",
      "display": {
        "label": "Histologic class",
        "choices": {
          "in_situ": "Carcinoma in situ",
          "invasive": "Invasive carcinoma",
          "unknown": "Unknown"
        }
      }
    },
    "depth_of_invasion": {
      "type": "enum",
      "default": "none",
      "values": ["none", "shallow", "deep"],
      "description": "Deep invasion = invasion beyond subcutaneous fat OR > 6 mm from granular layer of adjacent normal epidermis to base of tumor. Deep invasion is a T3 trigger.",
      "display": {
        "label": "Depth of invasion",
        "choices": {
          "none": "Not deep (within dermis / shallow)",
          "shallow": "Within dermis, < 6 mm",
          "deep": "Deep (beyond subcutaneous fat or > 6 mm)"
        }
      }
    },
    "perineural_invasion": {
      "type": "bool",
      "default": false,
      "description": "Perineural invasion (T3 trigger): tumor cells within nerve sheath of nerve deeper than dermis or >= 0.1 mm in caliber, or clinical/radiographic involvement of named nerves without skull base invasion or transgression.",
      "display": {"label": "Perineural invasion (T3)"}
    },
    "bone_invasion": {
      "type": "enum",
      "default": "none",
      "values": ["none", "minor_erosion", "gross_cortical_marrow", "skull_base"],
      "description": "Severity of bone involvement. 'minor_erosion' is a T3 trigger; 'gross_cortical_marrow' is T4a; 'skull_base' (skull base invasion and/or skull base foramen involvement) is T4b.",
      "display": {
        "label": "Bone involvement",
        "choices": {
          "none": "No bone involvement",
          "minor_erosion": "Minor bone erosion (T3)",
          "gross_cortical_marrow": "Gross cortical / marrow invasion (T4a)",
          "skull_base": "Skull base invasion or skull base foramen involvement (T4b)"
        }
      }
    },
    "positive_node_count": {
      "type": "number",
      "description": "Number of regional lymph nodes with metastatic involvement. 0 means N0.",
      "default": 0,
      "display": {"label": "Number of positive regional lymph nodes"}
    },
    "largest_positive_node_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the largest positive regional lymph node, in centimeters. Ignored when positive_node_count is 0.",
      "display": {"label": "Largest positive node (cm)"}
    },
    "node_laterality": {
      "type": "enum",
      "default": "ipsilateral",
      "values": ["ipsilateral", "contralateral", "bilateral"],
      "description": "Laterality of positive regional lymph nodes relative to the primary tumor. Midline nodes are considered ipsilateral.",
      "display": {
        "label": "Node laterality",
        "choices": {
          "ipsilateral": "Ipsilateral only",
          "contralateral": "Contralateral only",
          "bilateral": "Bilateral"
        }
      }
    },
    "ene": {
      "type": "enum",
      "default": "negative",
      "values": ["negative", "positive"],
      "description": "Extranodal extension status (ENE). For cN, clinical ENE; for pN, pathological ENE.",
      "display": {
        "label": "Extranodal extension (ENE)",
        "choices": {
          "negative": "ENE(-)",
          "positive": "ENE(+)"
        }
      }
    },
    "distant_mets": {
      "type": "bool",
      "default": false,
      "description": "Distant metastasis present (M1).",
      "display": {"label": "Distant metastasis (M1)"}
    }
  },
  "axes": {
    "T": [
      {
        "label": "Tis: carcinoma in situ",
        "when": {"histology": {"eq": "in_situ"}},
        "then": "Tis"
      },
      {
        "label": "T4b: skull base invasion or skull base foramen involvement",
        "when": {"bone_invasion": {"eq": "skull_base"}},
        "then": "T4b"
      },
      {
        "label": "T4a: gross cortical bone / marrow invasion",
        "when": {"bone_invasion": {"eq": "gross_cortical_marrow"}},
        "then": "T4a"
      },
      {
        "label": "T3: > 4 cm",
        "when": {"tumor_size_cm": {"gt": 4}},
        "then": "T3"
      },
      {
        "label": "T3: minor bone erosion",
        "when": {"bone_invasion": {"eq": "minor_erosion"}},
        "then": "T3"
      },
      {
        "label": "T3: perineural invasion",
        "when": {"perineural_invasion": {"eq": true}},
        "then": "T3"
      },
      {
        "label": "T3: deep invasion (beyond subcutaneous fat or > 6 mm)",
        "when": {"depth_of_invasion": {"eq": "deep"}},
        "then": "T3"
      },
      {
        "label": "T2: > 2 cm and <= 4 cm",
        "when": {"tumor_size_cm": {"gt": 2, "lte": 4}},
        "then": "T2"
      },
      {
        "label": "T1: <= 2 cm",
        "when": {"tumor_size_cm": {"lte": 2}},
        "then": "T1"
      }
    ],
    "N": [
      {
        "label": "N0: no positive regional nodes",
        "when": {"positive_node_count": {"eq": 0}},
        "then": "N0"
      },
      {
        "label": "N3b: any positive node with ENE+ (multi-node, or single ipsi > 3 cm, or contralateral)",
        "when": {"any_of": [
          {"positive_node_count": {"gte": 2}, "ene": {"eq": "positive"}},
          {"positive_node_count": {"eq": 1}, "largest_positive_node_cm": {"gt": 3}, "ene": {"eq": "positive"}, "node_laterality": {"eq": "ipsilateral"}},
          {"positive_node_count": {"eq": 1}, "ene": {"eq": "positive"}, "node_laterality": {"eq": "contralateral"}}
        ]},
        "then": "N3b"
      },
      {
        "label": "N3a: any node > 6 cm, ENE-",
        "when": {"largest_positive_node_cm": {"gt": 6}, "ene": {"eq": "negative"}},
        "then": "N3a"
      },
      {
        "label": "N2c: bilateral or contralateral, all <= 6 cm, ENE-",
        "when": {"positive_node_count": {"gte": 1}, "largest_positive_node_cm": {"lte": 6}, "ene": {"eq": "negative"}, "node_laterality": {"in": ["bilateral", "contralateral"]}},
        "then": "N2c"
      },
      {
        "label": "N2b: multiple ipsilateral, all <= 6 cm, ENE-",
        "when": {"positive_node_count": {"gte": 2}, "largest_positive_node_cm": {"lte": 6}, "ene": {"eq": "negative"}, "node_laterality": {"eq": "ipsilateral"}},
        "then": "N2b"
      },
      {
        "label": "N2a: single ipsi > 3 cm and <= 6 cm, ENE-",
        "when": {"positive_node_count": {"eq": 1}, "largest_positive_node_cm": {"gt": 3, "lte": 6}, "ene": {"eq": "negative"}, "node_laterality": {"eq": "ipsilateral"}},
        "then": "N2a"
      },
      {
        "label": "N1: single ipsilateral <= 3 cm, ENE-",
        "when": {"positive_node_count": {"eq": 1}, "largest_positive_node_cm": {"lte": 3}, "ene": {"eq": "negative"}, "node_laterality": {"eq": "ipsilateral"}},
        "then": "N1"
      }
    ],
    "M": [
      {"label": "M0: no distant metastasis", "when": {"distant_mets": {"eq": false}}, "then": "M0"},
      {"label": "M1: distant metastasis", "when": {"distant_mets": {"eq": true}}, "then": "M1"}
    ]
  },
  "examples": [
    {
      "label": "in situ -> Tis, N0, M0 (Stage 0)",
      "observations": {"histology": "in_situ"},
      "expect": {"T": "Tis", "N": "N0", "M": "M0"}
    },
    {
      "label": "1.5 cm tumor, no nodes -> T1, N0, M0 (Stage I)",
      "observations": {"tumor_size_cm": 1.5},
      "expect": {"T": "T1", "N": "N0", "M": "M0"}
    },
    {
      "label": "3 cm tumor, no nodes -> T2, N0, M0 (Stage II)",
      "observations": {"tumor_size_cm": 3.0},
      "expect": {"T": "T2", "N": "N0", "M": "M0"}
    },
    {
      "label": "5 cm tumor -> T3 (size > 4)",
      "observations": {"tumor_size_cm": 5.0},
      "expect": {"T": "T3", "N": "N0", "M": "M0"}
    },
    {
      "label": "2 cm tumor with perineural invasion -> T3",
      "observations": {"tumor_size_cm": 2.0, "perineural_invasion": true},
      "expect": {"T": "T3", "N": "N0", "M": "M0"}
    },
    {
      "label": "small tumor with minor bone erosion -> T3",
      "observations": {"tumor_size_cm": 1.5, "bone_invasion": "minor_erosion"},
      "expect": {"T": "T3", "N": "N0", "M": "M0"}
    },
    {
      "label": "small tumor with gross cortical bone invasion -> T4a",
      "observations": {"tumor_size_cm": 1.5, "bone_invasion": "gross_cortical_marrow"},
      "expect": {"T": "T4a", "N": "N0", "M": "M0"}
    },
    {
      "label": "tumor with skull base involvement -> T4b",
      "observations": {"tumor_size_cm": 3.0, "bone_invasion": "skull_base"},
      "expect": {"T": "T4b", "N": "N0", "M": "M0"}
    },
    {
      "label": "T1 with single ipsi 2 cm node ENE- -> N1 (Stage III)",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 1, "largest_positive_node_cm": 2.0, "node_laterality": "ipsilateral", "ene": "negative"},
      "expect": {"T": "T1", "N": "N1", "M": "M0"}
    },
    {
      "label": "T1 with single ipsi 4 cm node ENE- -> N2a (Stage IV)",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 1, "largest_positive_node_cm": 4.0, "node_laterality": "ipsilateral", "ene": "negative"},
      "expect": {"T": "T1", "N": "N2a", "M": "M0"}
    },
    {
      "label": "T1 with multiple ipsi nodes ENE- -> N2b",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 3, "largest_positive_node_cm": 2.5, "node_laterality": "ipsilateral", "ene": "negative"},
      "expect": {"T": "T1", "N": "N2b", "M": "M0"}
    },
    {
      "label": "T1 with bilateral nodes ENE- -> N2c",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 2, "largest_positive_node_cm": 3.0, "node_laterality": "bilateral", "ene": "negative"},
      "expect": {"T": "T1", "N": "N2c", "M": "M0"}
    },
    {
      "label": "T1 with single 7 cm node ENE- -> N3a",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 1, "largest_positive_node_cm": 7.0, "node_laterality": "ipsilateral", "ene": "negative"},
      "expect": {"T": "T1", "N": "N3a", "M": "M0"}
    },
    {
      "label": "T1 with single ipsi 4 cm ENE+ -> N3b",
      "observations": {"tumor_size_cm": 1.5, "positive_node_count": 1, "largest_positive_node_cm": 4.0, "node_laterality": "ipsilateral", "ene": "positive"},
      "expect": {"T": "T1", "N": "N3b", "M": "M0"}
    },
    {
      "label": "distant metastasis -> M1 (Stage IV)",
      "observations": {"tumor_size_cm": 1.5, "distant_mets": true},
      "expect": {"T": "T1", "N": "N0", "M": "M1"}
    },
    {
      "label": "no observations -> TX, N0, M0",
      "observations": {},
      "expect": {"T": "TX", "N": "N0", "M": "M0"}
    }
  ]
}
