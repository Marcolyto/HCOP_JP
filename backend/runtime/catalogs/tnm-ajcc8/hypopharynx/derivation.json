{
  "$schema_version": 1,
  "organ": "hypopharynx",
  "edition": "AJCC 8",
  "source": "pdfsource/hypopharynx.pdf",
  "observables": {
    "size_cm": {
      "type": "number",
      "unit": "cm",
      "display": {
        "label": "Greatest tumor dimension (cm)"
      }
    },
    "subsites_involved": {
      "type": "enum",
      "default": "one",
      "values": [
        "one",
        "more_than_one_or_adjacent",
        "fixation_or_extension_to_esophagus",
        "moderately_advanced_local",
        "very_advanced_local"
      ],
      "description": "Hypopharynx T extent. 'fixation_or_extension_to_esophagus' indicates hemilarynx fixation or extension to esophagus/larynx mucosa (T3). 'moderately_advanced_local' is T4a invasion. 'very_advanced_local' is T4b.",
      "display": {
        "label": "Hypopharynx subsite extent",
        "choices": {
          "one": "Limited to one subsite",
          "more_than_one_or_adjacent": "More than one subsite or an adjacent subsite (T2 candidate)",
          "fixation_or_extension_to_esophagus": "Hemilarynx fixation OR extension to esophagus/larynx mucosa (T3)",
          "moderately_advanced_local": "Moderately advanced local disease (T4a)",
          "very_advanced_local": "Very advanced local disease (T4b)"
        }
      }
    },
    "histology": {
      "type": "enum",
      "default": "invasive",
      "values": [
        "in_situ",
        "invasive",
        "unknown"
      ],
      "display": {
        "label": "Histologic class",
        "choices": {
          "in_situ": "Carcinoma in situ",
          "invasive": "Invasive carcinoma",
          "unknown": "Unknown"
        }
      }
    },
    "distant_mets": {
      "type": "bool",
      "default": false,
      "display": {
        "label": "Distant metastasis (M1)"
      }
    },
    "positive_node_count": {
      "type": "number",
      "default": 0,
      "description": "Number of regional lymph nodes with metastatic involvement. 0 means N0.",
      "display": {
        "label": "Number of positive regional lymph nodes"
      }
    },
    "largest_positive_node_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the largest positive regional lymph node, in centimeters. Ignored when positive_node_count is 0.",
      "display": {
        "label": "Largest positive node (cm)"
      }
    },
    "node_laterality": {
      "type": "enum",
      "default": "ipsilateral",
      "values": [
        "ipsilateral",
        "contralateral",
        "bilateral"
      ],
      "description": "Laterality of positive regional lymph nodes relative to the primary tumor. Midline nodes are considered ipsilateral.",
      "display": {
        "label": "Node laterality",
        "choices": {
          "ipsilateral": "Ipsilateral only",
          "contralateral": "Contralateral only",
          "bilateral": "Bilateral"
        }
      }
    },
    "ene": {
      "type": "enum",
      "default": "negative",
      "values": [
        "negative",
        "positive"
      ],
      "description": "Extranodal extension status (ENE). For cN, clinical ENE; for pN, pathological ENE.",
      "display": {
        "label": "Extranodal extension (ENE)",
        "choices": {
          "negative": "ENE(-)",
          "positive": "ENE(+)"
        }
      }
    }
  },
  "axes": {
    "T": [
      {
        "label": "Tis: in situ",
        "when": {
          "histology": {
            "eq": "in_situ"
          }
        },
        "then": "Tis"
      },
      {
        "label": "T4b: very advanced local",
        "when": {
          "subsites_involved": {
            "eq": "very_advanced_local"
          }
        },
        "then": "T4b"
      },
      {
        "label": "T4a: moderately advanced local",
        "when": {
          "subsites_involved": {
            "eq": "moderately_advanced_local"
          }
        },
        "then": "T4a"
      },
      {
        "label": "T3: fixation or extension to esophagus",
        "when": {
          "subsites_involved": {
            "eq": "fixation_or_extension_to_esophagus"
          }
        },
        "then": "T3"
      },
      {
        "label": "T2: > 2 cm OR more than one subsite",
        "when": {
          "any_of": [
            {
              "size_cm": {
                "gt": 2,
                "lte": 4
              }
            },
            {
              "subsites_involved": {
                "eq": "more_than_one_or_adjacent"
              }
            }
          ]
        },
        "then": "T2"
      },
      {
        "label": "T1: <= 2 cm and limited to one subsite",
        "when": {
          "size_cm": {
            "lte": 2
          },
          "subsites_involved": {
            "eq": "one"
          }
        },
        "then": "T1"
      }
    ],
    "N": [
      {
        "label": "N0: no positive regional nodes",
        "when": {
          "positive_node_count": {
            "eq": 0
          }
        },
        "then": "N0"
      },
      {
        "label": "N3b: any positive node with ENE+ (multi-node, or single ipsi > 3 cm, or contralateral)",
        "when": {
          "any_of": [
            {
              "positive_node_count": {
                "gte": 2
              },
              "ene": {
                "eq": "positive"
              }
            },
            {
              "positive_node_count": {
                "eq": 1
              },
              "largest_positive_node_cm": {
                "gt": 3
              },
              "ene": {
                "eq": "positive"
              },
              "node_laterality": {
                "eq": "ipsilateral"
              }
            },
            {
              "positive_node_count": {
                "eq": 1
              },
              "ene": {
                "eq": "positive"
              },
              "node_laterality": {
                "eq": "contralateral"
              }
            }
          ]
        },
        "then": "N3b"
      },
      {
        "label": "N3a: any node > 6 cm, ENE-",
        "when": {
          "largest_positive_node_cm": {
            "gt": 6
          },
          "ene": {
            "eq": "negative"
          }
        },
        "then": "N3a"
      },
      {
        "label": "N2c: bilateral or contralateral, all <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "gte": 1
          },
          "largest_positive_node_cm": {
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "in": [
              "bilateral",
              "contralateral"
            ]
          }
        },
        "then": "N2c"
      },
      {
        "label": "N2b: multiple ipsilateral, all <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "gte": 2
          },
          "largest_positive_node_cm": {
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2b"
      },
      {
        "label": "N2a: single ipsi <= 3 cm, ENE+ (mucosal-specific)",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "lte": 3
          },
          "ene": {
            "eq": "positive"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2a"
      },
      {
        "label": "N2a: single ipsi > 3 cm and <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "gt": 3,
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2a"
      },
      {
        "label": "N1: single ipsilateral <= 3 cm, ENE-",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "lte": 3
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N1"
      }
    ],
    "M": [
      {
        "label": "M0",
        "when": {
          "distant_mets": {
            "eq": false
          }
        },
        "then": "M0"
      },
      {
        "label": "M1",
        "when": {
          "distant_mets": {
            "eq": true
          }
        },
        "then": "M1"
      }
    ]
  },
  "examples": [
    {
      "label": "1 cm one subsite -> T1",
      "observations": {
        "size_cm": 1.0
      },
      "expect": {
        "T": "T1"
      }
    },
    {
      "label": "3 cm one subsite -> T2",
      "observations": {
        "size_cm": 3.0
      },
      "expect": {
        "T": "T2"
      }
    },
    {
      "label": "1 cm two subsites -> T2",
      "observations": {
        "size_cm": 1.0,
        "subsites_involved": "more_than_one_or_adjacent"
      },
      "expect": {
        "T": "T2"
      }
    },
    {
      "label": "hemilarynx fixation -> T3",
      "observations": {
        "size_cm": 2.0,
        "subsites_involved": "fixation_or_extension_to_esophagus"
      },
      "expect": {
        "T": "T3"
      }
    },
    {
      "label": "moderately advanced -> T4a",
      "observations": {
        "size_cm": 5.0,
        "subsites_involved": "moderately_advanced_local"
      },
      "expect": {
        "T": "T4a"
      }
    },
    {
      "label": "T2 + N2b + M0",
      "observations": {
        "size_cm": 3.0,
        "positive_node_count": 3,
        "largest_positive_node_cm": 3.0,
        "node_laterality": "ipsilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T2",
        "N": "N2b"
      }
    },
    {
      "label": "no observations -> TX, N0, M0",
      "observations": {},
      "expect": {
        "T": "TX",
        "N": "N0",
        "M": "M0"
      }
    }
  ]
}
