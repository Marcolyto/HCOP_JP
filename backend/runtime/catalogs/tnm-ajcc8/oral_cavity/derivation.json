{
  "$schema_version": 1,
  "organ": "oral_cavity",
  "edition": "AJCC 8",
  "source": "criteria/ajcc8/oral_cavity.json (AJCC 8 manual; no pdfsource/oral_cavity.pdf available)",
  "observables": {
    "size_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the primary tumor in centimeters. No default: absence falls through to TX.",
      "display": {
        "label": "Greatest tumor dimension (cm)"
      }
    },
    "doi_mm": {
      "type": "number",
      "unit": "mm",
      "description": "Depth of invasion in millimeters. AJCC 8 introduced DOI as a primary T-category driver. No default: absence prevents firing any size+DOI rule and falls through to TX.",
      "display": {
        "label": "Depth of invasion (mm)"
      }
    },
    "histology": {
      "type": "enum",
      "default": "invasive",
      "values": [
        "in_situ",
        "invasive",
        "unknown"
      ],
      "description": "Histologic class. 'in_situ' directs to Tis regardless of size.",
      "display": {
        "label": "Histologic class",
        "choices": {
          "in_situ": "Carcinoma in situ",
          "invasive": "Invasive carcinoma",
          "unknown": "Unknown"
        }
      }
    },
    "invades_adjacent": {
      "type": "bool",
      "default": false,
      "description": "Tumor invades adjacent structures: cortical bone of the mandible or maxilla, maxillary sinus, or skin of the face. A T4a trigger (moderately advanced).",
      "display": {
        "label": "Invades mandible/maxilla cortical bone, maxillary sinus, or facial skin (T4a)"
      }
    },
    "invades_severe": {
      "type": "bool",
      "default": false,
      "description": "Tumor invades masticator space, pterygoid plates, or skull base; OR encases the internal carotid artery. A T4b trigger (very advanced).",
      "display": {
        "label": "Invades masticator space, pterygoid plates, skull base, or encases carotid (T4b)"
      }
    },
    "distant_mets": {
      "type": "bool",
      "default": false,
      "description": "Distant metastasis present (M1).",
      "display": {
        "label": "Distant metastasis (M1)"
      }
    },
    "positive_node_count": {
      "type": "number",
      "default": 0,
      "description": "Number of regional lymph nodes with metastatic involvement. 0 means N0.",
      "display": {
        "label": "Number of positive regional lymph nodes"
      }
    },
    "largest_positive_node_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the largest positive regional lymph node, in centimeters. Ignored when positive_node_count is 0.",
      "display": {
        "label": "Largest positive node (cm)"
      }
    },
    "node_laterality": {
      "type": "enum",
      "default": "ipsilateral",
      "values": [
        "ipsilateral",
        "contralateral",
        "bilateral"
      ],
      "description": "Laterality of positive regional lymph nodes relative to the primary tumor. Midline nodes are considered ipsilateral.",
      "display": {
        "label": "Node laterality",
        "choices": {
          "ipsilateral": "Ipsilateral only",
          "contralateral": "Contralateral only",
          "bilateral": "Bilateral"
        }
      }
    },
    "ene": {
      "type": "enum",
      "default": "negative",
      "values": [
        "negative",
        "positive"
      ],
      "description": "Extranodal extension status (ENE). For cN, clinical ENE; for pN, pathological ENE.",
      "display": {
        "label": "Extranodal extension (ENE)",
        "choices": {
          "negative": "ENE(-)",
          "positive": "ENE(+)"
        }
      }
    }
  },
  "axes": {
    "T": [
      {
        "label": "Tis: carcinoma in situ",
        "when": {
          "histology": {
            "eq": "in_situ"
          }
        },
        "then": "Tis"
      },
      {
        "label": "T4b: masticator space, pterygoid plates, skull base, OR carotid encasement",
        "when": {
          "invades_severe": {
            "eq": true
          }
        },
        "then": "T4b"
      },
      {
        "label": "T4a: adjacent-structure invasion OR (> 4 cm AND DOI > 10 mm)",
        "when": {
          "any_of": [
            {
              "invades_adjacent": {
                "eq": true
              }
            },
            {
              "size_cm": {
                "gt": 4
              },
              "doi_mm": {
                "gt": 10
              }
            }
          ]
        },
        "then": "T4a"
      },
      {
        "label": "T3: (> 2 cm AND <= 4 cm AND DOI > 10 mm) OR (> 4 cm AND DOI <= 10 mm)",
        "when": {
          "any_of": [
            {
              "size_cm": {
                "gt": 2,
                "lte": 4
              },
              "doi_mm": {
                "gt": 10
              }
            },
            {
              "size_cm": {
                "gt": 4
              },
              "doi_mm": {
                "lte": 10
              }
            }
          ]
        },
        "then": "T3"
      },
      {
        "label": "T2: (<= 2 cm AND DOI > 5 AND <= 10 mm) OR (> 2 cm AND <= 4 cm AND DOI <= 10 mm)",
        "when": {
          "any_of": [
            {
              "size_cm": {
                "lte": 2
              },
              "doi_mm": {
                "gt": 5,
                "lte": 10
              }
            },
            {
              "size_cm": {
                "gt": 2,
                "lte": 4
              },
              "doi_mm": {
                "lte": 10
              }
            }
          ]
        },
        "then": "T2"
      },
      {
        "label": "T1: <= 2 cm AND DOI <= 5 mm",
        "when": {
          "size_cm": {
            "lte": 2
          },
          "doi_mm": {
            "lte": 5
          }
        },
        "then": "T1"
      }
    ],
    "N": [
      {
        "label": "N0: no positive regional nodes",
        "when": {
          "positive_node_count": {
            "eq": 0
          }
        },
        "then": "N0"
      },
      {
        "label": "N3b: any positive node with ENE+ (multi-node, or single ipsi > 3 cm, or contralateral)",
        "when": {
          "any_of": [
            {
              "positive_node_count": {
                "gte": 2
              },
              "ene": {
                "eq": "positive"
              }
            },
            {
              "positive_node_count": {
                "eq": 1
              },
              "largest_positive_node_cm": {
                "gt": 3
              },
              "ene": {
                "eq": "positive"
              },
              "node_laterality": {
                "eq": "ipsilateral"
              }
            },
            {
              "positive_node_count": {
                "eq": 1
              },
              "ene": {
                "eq": "positive"
              },
              "node_laterality": {
                "eq": "contralateral"
              }
            }
          ]
        },
        "then": "N3b"
      },
      {
        "label": "N3a: any node > 6 cm, ENE-",
        "when": {
          "largest_positive_node_cm": {
            "gt": 6
          },
          "ene": {
            "eq": "negative"
          }
        },
        "then": "N3a"
      },
      {
        "label": "N2c: bilateral or contralateral, all <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "gte": 1
          },
          "largest_positive_node_cm": {
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "in": [
              "bilateral",
              "contralateral"
            ]
          }
        },
        "then": "N2c"
      },
      {
        "label": "N2b: multiple ipsilateral, all <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "gte": 2
          },
          "largest_positive_node_cm": {
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2b"
      },
      {
        "label": "N2a: single ipsi <= 3 cm, ENE+ (mucosal-specific)",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "lte": 3
          },
          "ene": {
            "eq": "positive"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2a"
      },
      {
        "label": "N2a: single ipsi > 3 cm and <= 6 cm, ENE-",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "gt": 3,
            "lte": 6
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N2a"
      },
      {
        "label": "N1: single ipsilateral <= 3 cm, ENE-",
        "when": {
          "positive_node_count": {
            "eq": 1
          },
          "largest_positive_node_cm": {
            "lte": 3
          },
          "ene": {
            "eq": "negative"
          },
          "node_laterality": {
            "eq": "ipsilateral"
          }
        },
        "then": "N1"
      }
    ],
    "M": [
      {
        "label": "M0: no distant metastasis",
        "when": {
          "distant_mets": {
            "eq": false
          }
        },
        "then": "M0"
      },
      {
        "label": "M1: distant metastasis",
        "when": {
          "distant_mets": {
            "eq": true
          }
        },
        "then": "M1"
      }
    ]
  },
  "examples": [
    {
      "label": "in situ -> Tis, N0, M0",
      "observations": {
        "histology": "in_situ"
      },
      "expect": {
        "T": "Tis",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "1.5 cm tumor with 3 mm DOI -> T1, N0, M0",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0
      },
      "expect": {
        "T": "T1",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "1.5 cm tumor with 7 mm DOI -> T2 (small but deep)",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 7.0
      },
      "expect": {
        "T": "T2",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "3 cm tumor with 8 mm DOI -> T2 (medium with shallow DOI)",
      "observations": {
        "size_cm": 3.0,
        "doi_mm": 8.0
      },
      "expect": {
        "T": "T2",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "3 cm tumor with 15 mm DOI -> T3 (deep DOI bumps T)",
      "observations": {
        "size_cm": 3.0,
        "doi_mm": 15.0
      },
      "expect": {
        "T": "T3",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "5 cm tumor with 8 mm DOI -> T3 (size > 4 with DOI <= 10)",
      "observations": {
        "size_cm": 5.0,
        "doi_mm": 8.0
      },
      "expect": {
        "T": "T3",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "5 cm tumor with 15 mm DOI -> T4a (size > 4 AND DOI > 10)",
      "observations": {
        "size_cm": 5.0,
        "doi_mm": 15.0
      },
      "expect": {
        "T": "T4a",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "small tumor invading mandible (T4a regardless of size)",
      "observations": {
        "size_cm": 1.0,
        "doi_mm": 3.0,
        "invades_adjacent": true
      },
      "expect": {
        "T": "T4a",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "tumor encasing carotid (T4b)",
      "observations": {
        "size_cm": 3.0,
        "doi_mm": 8.0,
        "invades_severe": true
      },
      "expect": {
        "T": "T4b",
        "N": "N0",
        "M": "M0"
      }
    },
    {
      "label": "single ipsi 2 cm node ENE- -> N1",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 2.0,
        "node_laterality": "ipsilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T1",
        "N": "N1",
        "M": "M0"
      }
    },
    {
      "label": "single ipsi 2 cm node ENE+ -> N2a",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 2.0,
        "node_laterality": "ipsilateral",
        "ene": "positive"
      },
      "expect": {
        "T": "T1",
        "N": "N2a",
        "M": "M0"
      }
    },
    {
      "label": "single ipsi 5 cm node ENE- -> N2a",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 4.0,
        "node_laterality": "ipsilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T1",
        "N": "N2a",
        "M": "M0"
      }
    },
    {
      "label": "multiple ipsi nodes <= 6 cm ENE- -> N2b",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 3,
        "largest_positive_node_cm": 3.0,
        "node_laterality": "ipsilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T1",
        "N": "N2b",
        "M": "M0"
      }
    },
    {
      "label": "bilateral nodes <= 6 cm ENE- -> N2c",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 2,
        "largest_positive_node_cm": 3.0,
        "node_laterality": "bilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T1",
        "N": "N2c",
        "M": "M0"
      }
    },
    {
      "label": "any node > 6 cm ENE- -> N3a",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 7.0,
        "node_laterality": "ipsilateral",
        "ene": "negative"
      },
      "expect": {
        "T": "T1",
        "N": "N3a",
        "M": "M0"
      }
    },
    {
      "label": "single ipsi > 3 cm ENE+ -> N3b",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 4.0,
        "node_laterality": "ipsilateral",
        "ene": "positive"
      },
      "expect": {
        "T": "T1",
        "N": "N3b",
        "M": "M0"
      }
    },
    {
      "label": "single contralateral ENE+ -> N3b",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "positive_node_count": 1,
        "largest_positive_node_cm": 2.0,
        "node_laterality": "contralateral",
        "ene": "positive"
      },
      "expect": {
        "T": "T1",
        "N": "N3b",
        "M": "M0"
      }
    },
    {
      "label": "distant metastasis -> M1",
      "observations": {
        "size_cm": 1.5,
        "doi_mm": 3.0,
        "distant_mets": true
      },
      "expect": {
        "T": "T1",
        "N": "N0",
        "M": "M1"
      }
    },
    {
      "label": "no observations -> TX, N0, M0",
      "observations": {},
      "expect": {
        "T": "TX",
        "N": "N0",
        "M": "M0"
      }
    }
  ]
}
