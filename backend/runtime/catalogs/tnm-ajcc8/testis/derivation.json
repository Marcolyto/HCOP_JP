{
  "$schema_version": 1,
  "organ": "testis",
  "edition": "AJCC 8",
  "source": "pdfsource/_pages_testisv8/",
  "observables": {
    "tumor_extent": {
      "type": "enum",
      "default": "unknown",
      "values": [
        "unknown",
        "in_situ",
        "limited_to_testis_no_lvi",
        "limited_to_testis_no_lvi_lt_3cm",
        "limited_to_testis_no_lvi_ge_3cm",
        "limited_to_testis_with_lvi_or_hilar_or_tunica",
        "spermatic_cord",
        "scrotum"
      ],
      "description": "Pathological anatomic extent of the primary testicular tumor (from radical orchiectomy specimen).",
      "display": {
        "label": "Pathological extent of primary tumor",
        "choices": {
          "unknown": "Unknown / not assessable (pTX)",
          "in_situ": "Germ cell neoplasia in situ (pTis)",
          "limited_to_testis_no_lvi": "Limited to testis (incl. rete testis), no LVI -- size unknown (pT1)",
          "limited_to_testis_no_lvi_lt_3cm": "Limited to testis, no LVI, < 3 cm (pT1a; pure seminoma)",
          "limited_to_testis_no_lvi_ge_3cm": "Limited to testis, no LVI, ≥ 3 cm (pT1b; pure seminoma)",
          "limited_to_testis_with_lvi_or_hilar_or_tunica": "Limited to testis with LVI, OR hilar soft tissue / epididymis / tunica albuginea visceral mesothelium penetration (pT2)",
          "spermatic_cord": "Invades spermatic cord soft tissue (pT3)",
          "scrotum": "Invades scrotum (pT4)"
        }
      }
    },
    "lymph_node_mass_cm": {
      "type": "number",
      "unit": "cm",
      "description": "Greatest dimension of the largest involved regional (retroperitoneal) lymph node mass on pathologic examination. 0 if no node positive.",
      "default": 0,
      "display": {"label": "Largest regional lymph node mass (cm)"}
    },
    "positive_node_count": {
      "type": "number",
      "default": 0,
      "description": "Number of regional lymph nodes with metastasis on pathologic examination.",
      "display": {"label": "Positive regional lymph nodes (count)"}
    },
    "extranodal_extension": {
      "type": "bool",
      "default": false,
      "description": "Extranodal extension of tumor in any positive lymph node.",
      "display": {"label": "Extranodal extension present"}
    },
    "distant_mets": {
      "type": "enum",
      "default": "none",
      "values": ["none", "non_retroperitoneal_or_pulmonary", "non_pulmonary_visceral", "unspecified"],
      "description": "Pattern of distant metastasis.",
      "display": {
        "label": "Distant metastasis",
        "choices": {
          "none": "No distant metastasis (M0)",
          "non_retroperitoneal_or_pulmonary": "Non-retroperitoneal nodal or pulmonary metastases (M1a)",
          "non_pulmonary_visceral": "Non-pulmonary visceral metastases (M1b)",
          "unspecified": "Distant metastasis present, site unspecified (M1)"
        }
      }
    },
    "serum_marker_level": {
      "type": "enum",
      "default": "unknown",
      "values": ["unknown", "normal", "elevated_s1", "elevated_s2", "elevated_s3"],
      "description": "Highest post-orchiectomy serum tumor marker level (LDH, hCG, AFP).",
      "display": {
        "label": "Serum tumor markers (LDH/hCG/AFP)",
        "choices": {
          "unknown": "Not available / not performed (SX)",
          "normal": "All markers within normal limits (S0)",
          "elevated_s1": "LDH < 1.5xN AND hCG < 5,000 AND AFP < 1,000 (S1)",
          "elevated_s2": "LDH 1.5-10xN OR hCG 5,000-50,000 OR AFP 1,000-10,000 (S2)",
          "elevated_s3": "LDH > 10xN OR hCG > 50,000 OR AFP > 10,000 (S3)"
        }
      }
    }
  },
  "axes": {
    "T": [
      {"label": "pTis: germ cell neoplasia in situ", "when": {"tumor_extent": {"eq": "in_situ"}}, "then": "pTis"},
      {"label": "pT1a: limited to testis, no LVI, < 3 cm", "when": {"tumor_extent": {"eq": "limited_to_testis_no_lvi_lt_3cm"}}, "then": "pT1a"},
      {"label": "pT1b: limited to testis, no LVI, >= 3 cm", "when": {"tumor_extent": {"eq": "limited_to_testis_no_lvi_ge_3cm"}}, "then": "pT1b"},
      {"label": "pT1: limited to testis, no LVI, size unknown", "when": {"tumor_extent": {"eq": "limited_to_testis_no_lvi"}}, "then": "pT1"},
      {"label": "pT2: testis with LVI or hilar / tunica penetration", "when": {"tumor_extent": {"eq": "limited_to_testis_with_lvi_or_hilar_or_tunica"}}, "then": "pT2"},
      {"label": "pT3: invades spermatic cord", "when": {"tumor_extent": {"eq": "spermatic_cord"}}, "then": "pT3"},
      {"label": "pT4: invades scrotum", "when": {"tumor_extent": {"eq": "scrotum"}}, "then": "pT4"}
    ],
    "N": [
      {"label": "N0: no positive nodes", "when": {"positive_node_count": {"eq": 0}, "lymph_node_mass_cm": {"eq": 0}}, "then": "N0"},
      {"label": "N3: lymph node mass > 5 cm", "when": {"lymph_node_mass_cm": {"gt": 5}}, "then": "N3"},
      {"label": "N2: mass 2-5 cm OR > 5 nodes OR ENE", "when": {"any_of": [{"lymph_node_mass_cm": {"gt": 2, "lte": 5}}, {"positive_node_count": {"gt": 5}}, {"extranodal_extension": {"eq": true}}]}, "then": "N2"},
      {"label": "N1: mass <= 2 cm and <= 5 nodes", "when": {"lymph_node_mass_cm": {"gt": 0, "lte": 2}, "positive_node_count": {"gte": 1, "lte": 5}, "extranodal_extension": {"eq": false}}, "then": "N1"},
      {"label": "N1: nodes positive but mass not measured", "when": {"positive_node_count": {"gte": 1, "lte": 5}, "lymph_node_mass_cm": {"eq": 0}, "extranodal_extension": {"eq": false}}, "then": "N1"}
    ],
    "M": [
      {"label": "M0: no distant mets", "when": {"distant_mets": {"eq": "none"}}, "then": "M0"},
      {"label": "M1a: non-retroperitoneal nodal or pulmonary", "when": {"distant_mets": {"eq": "non_retroperitoneal_or_pulmonary"}}, "then": "M1a"},
      {"label": "M1b: non-pulmonary visceral", "when": {"distant_mets": {"eq": "non_pulmonary_visceral"}}, "then": "M1b"},
      {"label": "M1: distant mets, site unspecified", "when": {"distant_mets": {"eq": "unspecified"}}, "then": "M1"}
    ],
    "S": [
      {"label": "SX: marker studies not available", "when": {"serum_marker_level": {"eq": "unknown"}}, "then": "SX"},
      {"label": "S0: markers within normal limits", "when": {"serum_marker_level": {"eq": "normal"}}, "then": "S0"},
      {"label": "S1: elevated S1 band", "when": {"serum_marker_level": {"eq": "elevated_s1"}}, "then": "S1"},
      {"label": "S2: elevated S2 band", "when": {"serum_marker_level": {"eq": "elevated_s2"}}, "then": "S2"},
      {"label": "S3: elevated S3 band", "when": {"serum_marker_level": {"eq": "elevated_s3"}}, "then": "S3"}
    ]
  },
  "examples": [
    {"label": "in situ -> pTis N0 M0", "observations": {"tumor_extent": "in_situ"}, "expect": {"T": "pTis", "N": "N0", "M": "M0"}},
    {"label": "small seminoma, no LVI, < 3 cm, markers normal -> pT1a N0 M0", "observations": {"tumor_extent": "limited_to_testis_no_lvi_lt_3cm", "serum_marker_level": "normal"}, "expect": {"T": "pT1a", "N": "N0", "M": "M0"}},
    {"label": "pT2 + 1.5 cm node + S1 -> pT2 N1 M0", "observations": {"tumor_extent": "limited_to_testis_with_lvi_or_hilar_or_tunica", "lymph_node_mass_cm": 1.5, "positive_node_count": 2, "serum_marker_level": "elevated_s1"}, "expect": {"T": "pT2", "N": "N1", "M": "M0"}},
    {"label": "pT3 + 3 cm node + S2 -> pT3 N2 M0", "observations": {"tumor_extent": "spermatic_cord", "lymph_node_mass_cm": 3.0, "positive_node_count": 3, "serum_marker_level": "elevated_s2"}, "expect": {"T": "pT3", "N": "N2", "M": "M0"}},
    {"label": "pT4 + 6 cm node + M1a + S3 -> pT4 N3 M1a", "observations": {"tumor_extent": "scrotum", "lymph_node_mass_cm": 6.0, "positive_node_count": 4, "distant_mets": "non_retroperitoneal_or_pulmonary", "serum_marker_level": "elevated_s3"}, "expect": {"T": "pT4", "N": "N3", "M": "M1a"}},
    {"label": "M1b non-pulmonary visceral -> pT3 N0 M1b", "observations": {"tumor_extent": "spermatic_cord", "distant_mets": "non_pulmonary_visceral", "serum_marker_level": "elevated_s2"}, "expect": {"T": "pT3", "N": "N0", "M": "M1b"}},
    {"label": "no observations -> defaults N0, M0", "observations": {}, "expect": {"N": "N0", "M": "M0"}}
  ]
}
