    clinical_treatments ||--o{ treatment_workflow_requests : sobre
    treatment_workflow_requests ||--o{ clinical_workflow_events : genera
    patients ||--o{ clinical_workflow_events : sobre
    clinical_treatments ||--o{ clinical_workflow_events : sobre
