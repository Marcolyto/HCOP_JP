{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm" },
  "projects": {
    "hcop-jp-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "baseHref": "/app/",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "pdf.worker.min.mjs", "input": "node_modules/pdfjs-dist/build", "output": "assets/pdfjs" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/cmaps", "output": "assets/pdfjs/cmaps" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/standard_fonts", "output": "assets/pdfjs/standard_fonts" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/wasm", "output": "assets/pdfjs/wasm" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/iccs", "output": "assets/pdfjs/iccs" }
            ],
            "allowedCommonJsDependencies": ["jsqr"],
            "styles": [
              "src/styles.scss",
              "src/generated/legacy-visual-contract/styles.css",
              "src/generated/legacy-visual-contract/care-scheduler.css",
              "src/generated/legacy-visual-contract/care-scheduler-modal.css",
              "src/generated/legacy-visual-contract/help.css"
            ]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "750kB", "maximumError": "1.2MB" }] },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "hcop-jp-angular:build:production" },
            "development": { "buildTarget": "hcop-jp-angular:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
